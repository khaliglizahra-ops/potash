# Public site URL (used in sitemap, canonical URLs, structured data and the iyzico callback)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Random 64-hex string. REQUIRED in production (signs customer and admin sessions).
SESSION_SECRET=
# Admin panel password. REQUIRED in production.
ADMIN_PASSWORD=

# iyzico (sandbox keys for testing; live keys + https://api.iyzipay.com for production)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Shown on the order page for bank-transfer orders
BANK_NAME=
BANK_IBAN=

# Keep these OUTSIDE the deployed folder so redeploys never wipe orders or uploads
DATABASE_PATH=/home/USER/nukleon-data/nukleon.db
UPLOAD_DIR=/home/USER/nukleon-data/uploads
